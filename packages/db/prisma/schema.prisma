generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Applied application schema revision. Product modules add their own tables.
model FoundationRevision {
  id         String   @id
  revision   String
  summary    String
  recordedAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("foundation_revision")
}

model Guild {
  guildId     String   @id
  ownerUserId String?
  timezone    String   @default("Australia/Perth")
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@map("guild")
}

model ConfigVersion {
  id          String    @id
  guildId     String
  version     Int
  state       String
  document    Json
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  publishedAt DateTime? @db.Timestamptz(6)

  @@unique([guildId, version])
  @@index([guildId, state])
  @@map("config_version")
}

model CapabilityGrant {
  id         String @id
  guildId    String
  roleId     String
  capability String

  @@unique([guildId, roleId, capability])
  @@map("capability_grant")
}

model DashboardGrant {
  id        String @id
  guildId   String
  kind      String
  subjectId String

  @@unique([guildId, kind, subjectId])
  @@map("dashboard_grant")
}

model FeatureFlag {
  id          String   @id
  guildId     String
  moduleKey   String
  maintenance Boolean  @default(false)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@unique([guildId, moduleKey])
  @@map("feature_flag")
}

model AuditRecord {
  id          String   @id
  guildId     String
  actorUserId String
  action      String
  targetType  String
  targetId    String
  reason      String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([guildId, createdAt])
  @@map("audit_record")
}

model Job {
  id             String    @id
  guildId        String?
  jobType        String
  payload        Json
  idempotencyKey String    @unique
  status         String
  runAt          DateTime  @db.Timestamptz(6)
  attempts       Int       @default(0)
  maxAttempts    Int
  leaseOwner     String?
  leaseUntil     DateTime? @db.Timestamptz(6)
  lastError      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  @@index([status, runAt])
  @@map("job")
}

model OutboxMessage {
  id             String    @id
  guildId        String?
  eventType      String
  payload        Json
  idempotencyKey String    @unique
  status         String
  attempts       Int       @default(0)
  maxAttempts    Int
  availableAt    DateTime  @db.Timestamptz(6)
  leaseOwner     String?
  leaseUntil     DateTime? @db.Timestamptz(6)
  lastError      String?
  deliveredAt    DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, availableAt])
  @@map("outbox_message")
}

model InteractionSession {
  id                 String    @id
  guildId            String
  actorUserId        String
  revision           Int
  requiredCapability String?
  purpose            String
  payload            Json
  expiresAt          DateTime  @db.Timestamptz(6)
  consumedAt         DateTime? @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)

  @@index([guildId, actorUserId])
  @@map("interaction_session")
}

model OauthState {
  id         String    @id
  stateHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  @@map("oauth_state")
}

model AdminSession {
  id        String    @id
  tokenHash String    @unique
  csrfToken String
  userId    String
  guildId   String
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  @@map("admin_session")
}

model AuthAttempt {
  id          String   @id
  subjectHash String
  windowStart DateTime @db.Timestamptz(6)
  count       Int

  @@unique([subjectHash, windowStart])
  @@map("auth_attempt")
}

model CommunitySettings {
  guildId   String   @id
  document  Json
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("community_settings")
}

model VerificationRecord {
  id            String    @id
  guildId       String
  userId        String
  status        String
  method        String?
  failureCount  Int       @default(0)
  cooldownUntil DateTime? @db.Timestamptz(6)
  verifiedAt    DateTime? @db.Timestamptz(6)
  revokedAt     DateTime? @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([guildId, userId])
  @@map("verification_record")
}

model CaptchaChallenge {
  id            String    @id
  guildId       String
  userId        String
  answerHash    String
  expiresAt     DateTime  @db.Timestamptz(6)
  invalidatedAt DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([guildId, userId])
  @@map("captcha_challenge")
}

model AssistanceRequest {
  id         String    @id
  guildId    String
  userId     String
  note       String
  status     String
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  resolvedAt DateTime? @db.Timestamptz(6)

  @@index([guildId, status])
  @@map("assistance_request")
}

model RolePanel {
  id         String    @id
  guildId    String
  name       String
  mode       String
  selection  String
  retiredAt  DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([guildId])
  @@map("role_panel")
}

model RolePanelOption {
  id                   String @id
  panelId              String
  roleId               String
  label                String
  exclusiveGroup       String?
  prerequisiteRoleIds  Json
  emoji                String?

  @@unique([panelId, roleId])
  @@map("role_panel_option")
}

model RoleEntitlement {
  id                 String    @id
  guildId            String
  userId             String
  roleId             String
  kind               String
  source             String
  sourceId           String
  expiresAt          DateTime? @db.Timestamptz(6)
  pausedRemainingMs  Int?
  endedAt            DateTime? @db.Timestamptz(6)
  endReason          String?
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([guildId, userId, roleId, source, sourceId])
  @@index([expiresAt])
  @@map("role_entitlement")
}

model LinkedAccount {
  id              String    @id
  guildId         String
  userId          String
  provider        String
  handle          String
  visibility      String
  ownership       String
  providerSubject String?
  unlinkedAt      DateTime? @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([guildId, userId, provider])
  @@map("linked_account")
}

model RolePanelPost {
  messageId String   @id
  guildId   String
  channelId String
  panelId   String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([panelId])
  @@map("role_panel_post")
}

model ModerationPolicy {
  guildId   String   @id
  version   Int
  label     String
  document  Json
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("moderation_policy")
}

model ModerationCase {
  id             String    @id
  guildId        String
  targetUserId   String
  actorUserId    String
  actorKind      String
  action         String
  outcome        String
  failureReason  String?
  reason         String
  evidence       Json
  ruleId         String?
  ruleVersion    Int?
  points         Int       @default(0)
  relatedCaseId  String?
  expiresAt      DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  @@index([guildId, targetUserId])
  @@map("moderation_case")
}

model WarningPoint {
  id        String    @id
  guildId   String
  userId    String
  caseId    String
  points    Int
  status    String
  expiresAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  @@index([guildId, userId, status])
  @@map("warning_point")
}

model ModerationAppeal {
  id         String    @id
  guildId    String
  caseId     String
  userId     String
  note       String
  status     String
  resolution String?
  ticketId   String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  resolvedAt DateTime? @db.Timestamptz(6)

  @@index([guildId, caseId])
  @@map("moderation_appeal")
}

model MemberReport {
  id             String   @id
  guildId        String
  reporterUserId String
  targetUserId   String
  note           String
  status         String
  ticketStatus   String
  ticketId       String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([guildId, reporterUserId])
  @@map("member_report")
}

model StaffLog {
  id               String   @id
  guildId          String
  kind             String
  channelId        String?
  actorUserId      String?
  actorConfidence  String
  targetId         String?
  content          String?
  contentLabel     String
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  retainUntil      DateTime @db.Timestamptz(6)

  @@index([guildId, createdAt])
  @@index([retainUntil])
  @@map("staff_log")
}

model ModerationSignal {
  id           String   @id
  guildId      String
  userId       String
  channelId    String?
  kind         String
  contentHash  String?
  mentionCount Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([guildId, kind, createdAt])
  @@map("moderation_signal")
}

model TicketSettings {
  guildId   String   @id
  version   Int
  label     String
  document  Json
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("ticket_settings")
}

model TicketPanel {
  id          String   @id
  guildId     String
  label       String
  categoryIds Json
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([guildId])
  @@map("ticket_panel")
}

model SupportTicket {
  id             String    @id
  guildId        String
  number         Int
  openerUserId   String
  status         String
  assigneeUserId String?
  formAnswers    Json
  summary        String?
  policySnapshot Json
  channelId      String?
  channelState   String
  openedAt       DateTime  @default(now()) @db.Timestamptz(6)
  closedAt       DateTime? @db.Timestamptz(6)
  closeReason    String?
  lastHumanAt    DateTime  @db.Timestamptz(6)
  remindedAt     DateTime? @db.Timestamptz(6)
  reopenUntil    DateTime? @db.Timestamptz(6)
  contentLabel   String
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([guildId, number])
  @@index([guildId, openerUserId, status])
  @@map("support_ticket")
}

model TicketMessage {
  id           String   @id
  ticketId     String
  guildId      String
  authorUserId String
  authorKind   String
  visibility   String
  body         String?
  contentLabel String
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([ticketId, createdAt])
  @@map("ticket_message")
}

model TicketReference {
  id                  String   @id
  ticketId            String
  guildId             String
  kind                String
  targetId            String
  integrationStatus   String
  createdAt           DateTime @default(now()) @db.Timestamptz(6)

  @@unique([ticketId, kind, targetId])
  @@index([guildId, kind])
  @@map("ticket_reference")
}

model ProgressionSettings {
  guildId   String   @id
  version   Int
  label     String
  document  Json
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("progression_settings")
}

model MemberProgression {
  guildId         String
  userId          String
  xp              Int      @default(0)
  rankBandId      String?
  lastMessageAt   DateTime? @db.Timestamptz(6)
  lastHash        String?
  lastHashAt      DateTime? @db.Timestamptz(6)
  dailyKey        String?
  dailyMessageXp  Int      @default(0)
  dailyVoiceXp    Int      @default(0)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  @@id([guildId, userId])
  @@map("member_progression")
}

model DossierProfile {
  guildId     String
  userId      String
  bio         String?
  bioPublic   Boolean  @default(false)
  title       String?
  frame       String?
  background  String?
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@id([guildId, userId])
  @@map("dossier_profile")
}

model BirthdayRecord {
  guildId    String
  userId     String
  month      Int?
  day        Int?
  year       Int?
  timeZone   String
  announce   Boolean  @default(false)
  editedAt   DateTime? @db.Timestamptz(6)
  deletedAt  DateTime? @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@id([guildId, userId])
  @@map("birthday_record")
}

model InviteMembership {
  guildId       String
  userId        String
  confidence    String
  inviterUserId String?
  joinedAt      DateTime @db.Timestamptz(6)
  verifiedAt    DateTime? @db.Timestamptz(6)
  rewardedAt    DateTime? @db.Timestamptz(6)
  rejoin        Boolean  @default(false)
  suspicious    Boolean  @default(false)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  @@id([guildId, userId])
  @@index([guildId, inviterUserId])
  @@map("invite_membership")
}

model InviteEvent {
  id            String   @id
  guildId       String
  userId        String
  confidence    String
  inviterUserId String?
  rejoin        Boolean
  suspicious    Boolean
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@index([guildId, createdAt])
  @@map("invite_event")
}

model RewardEvent {
  id               String   @id
  guildId          String
  userId           String
  source           String
  sourceId         String
  kind             String
  amount           Int?
  ledgerStatus     String
  status           String
  idempotencyKey   String   @unique
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  @@index([guildId, userId, source])
  @@map("reward_event")
}

model MemberAchievement {
  guildId       String
  userId        String
  achievementId String
  earnedAt      DateTime @db.Timestamptz(6)

  @@id([guildId, userId, achievementId])
  @@map("member_achievement")
}

model Commendation {
  id         String   @id
  guildId    String
  fromUserId String
  toUserId   String
  kind       String
  category   String
  reason     String
  status     String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([guildId, fromUserId, toUserId])
  @@map("commendation")
}

model VoiceSession {
  guildId         String
  userId          String
  channelId       String
  lastAwardedAt   DateTime @db.Timestamptz(6)
  eligibleHumans  Int
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  @@id([guildId, userId])
  @@map("voice_session")
}

model SeasonSettings {
  guildId   String   @id
  version   Int
  label     String
  document  Json
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("season_settings")
}

model SeasonState {
  guildId    String   @id
  seasonId   String
  startsAt   DateTime @db.Timestamptz(6)
  endsAt     DateTime @db.Timestamptz(6)
  rolledFrom String?
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@map("season_state")
}

model SeasonalScore {
  guildId  String
  userId   String
  seasonId String
  seals    Int    @default(0)

  @@id([guildId, userId, seasonId])
  @@index([guildId, seasonId])
  @@map("seasonal_score")
}

model LifetimeScore {
  guildId String
  userId  String
  seals   Int    @default(0)

  @@id([guildId, userId])
  @@map("lifetime_score")
}

model SeasonArchive {
  id           String   @id
  guildId      String
  seasonId     String
  category     String
  availability String
  standings    Json
  preservation Json
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([guildId, seasonId, category])
  @@map("season_archive")
}

model Poll {
  id              String   @id
  guildId         String
  question        String
  mode            String
  anonymous       Boolean
  eligibleRoleIds Json
  opensAt         DateTime @db.Timestamptz(6)
  closesAt        DateTime @db.Timestamptz(6)
  status          String
  createdBy       String
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@index([guildId, status])
  @@map("poll")
}

model PollChoice {
  id       String @id
  pollId   String
  guildId  String
  label    String
  position Int

  @@index([pollId])
  @@map("poll_choice")
}

model PollVote {
  id        String   @id
  pollId    String
  guildId   String
  userId    String
  choiceId  String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([pollId, userId, choiceId])
  @@index([pollId])
  @@map("poll_vote")
}

model TempRoom {
  id              String    @id
  guildId         String
  kind            String
  ownerUserId     String
  name            String
  privacy         String
  locked          Boolean   @default(false)
  capacity        Int       @default(10)
  occupants       Json
  invitedUserIds  Json
  lastHumanAt     DateTime  @db.Timestamptz(6)
  emptySince      DateTime? @db.Timestamptz(6)
  channelId       String?
  channelState    String
  status          String
  closeReason     String?
  missionHold     Boolean   @default(false)
  needsStaff      Boolean   @default(false)
  disconnectState String
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  closedAt        DateTime? @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  @@index([guildId, status, kind])
  @@map("temp_room")
}

model EconomySettings {
  guildId   String   @id
  version   Int
  label     String
  document  Json
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("economy_settings")
}

model Wallet {
  guildId        String
  userId         String
  currency       String
  availableMinor BigInt   @default(0)
  escrowMinor    BigInt   @default(0)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  @@id([guildId, userId, currency])
  @@index([guildId, currency])
  @@map("wallet")
}

model LedgerEntry {
  id              String   @id
  guildId         String
  userId          String
  currency        String
  direction       String
  kind            String
  amountMinor     BigInt
  source          String
  sourceId        String
  pace            String
  idempotencyKey  String   @unique
  reversesEntryId String?
  reason          String
  actorUserId     String
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@index([guildId, userId, createdAt])
  @@index([guildId, kind])
  @@map("ledger_entry")
}

model IssuanceBudget {
  guildId         String
  scope           String
  periodKey       String
  subjectId       String
  authorizedMinor BigInt
  spentMinor      BigInt   @default(0)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  @@id([guildId, scope, periodKey, subjectId])
  @@map("issuance_budget")
}

model IngotMarket {
  guildId             String    @id
  protectedReserve    BigInt
  inventory           BigInt
  eventTreasury       BigInt
  chargeReserve       BigInt
  backingMinor        BigInt
  revision            Int
  curveVersion        Int
  baselineMarks       BigInt
  activeSupply        BigInt
  spreadBps           Int
  quoteSeconds        Int
  paused              Boolean   @default(false)
  panelChannelId      String?
  panelCoalesceUntil  DateTime? @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)

  @@map("ingot_market")
}

model MarketQuote {
  id               String    @id
  guildId          String
  userId           String
  side             String
  quantity         BigInt
  totalMinor       BigInt
  revision         Int
  curveVersion     Int
  inventoryAtQuote BigInt
  status           String
  idempotencyKey   String    @unique
  expiresAt        DateTime  @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)

  @@index([guildId, userId, status])
  @@map("market_quote")
}

model MarketTrade {
  id              String   @id
  guildId         String
  quoteId         String
  userId          String
  side            String
  quantity        BigInt
  totalMinor      BigInt
  inventoryAfter  BigInt
  revisionAfter   Int
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@index([guildId, createdAt])
  @@map("market_trade")
}

model CollapseCharge {
  id             String    @id
  guildId        String
  holderUserId   String
  quantity       BigInt
  status         String
  idempotencyKey String    @unique
  announcement   String
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  activatedAt    DateTime? @db.Timestamptz(6)

  @@index([guildId, status])
  @@map("collapse_charge")
}

model PublicationTemplate {
  id            String   @id
  guildId       String
  name          String
  document      Json
  authorUserId  String
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@index([guildId, name])
  @@map("publication_template")
}

model PublicationDraft {
  id                 String   @id
  guildId            String
  authorUserId       String
  revision           Int
  committedRevision  Int?
  status             String
  label              String
  document           Json
  templateId         String?
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  @@index([guildId, status])
  @@map("publication_draft")
}

model PublicationReview {
  id             String    @id
  guildId        String
  draftId        String
  revision       Int
  channelId      String
  status         String
  delivery       String
  preview        Json
  controls       Json
  feedback       String?
  actorUserId    String?
  decidedAt      DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([guildId, draftId, status])
  @@map("publication_review")
}

model PublicationMessage {
  id                   String    @id
  guildId              String
  draftId              String
  reviewId             String
  revision             Int
  destinationChannelId String
  discordMessageId     String?
  delivery             String
  status               String
  mode                 String
  snapshot             Json
  authorUserId         String
  approverUserId       String
  scheduledFor         DateTime? @db.Timestamptz(6)
  publishedAt          DateTime? @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)

  @@index([guildId, status])
  @@index([draftId, status])
  @@map("publication_message")
}

model PublicationHistory {
  id             String   @id
  guildId        String
  messageId      String
  draftId        String
  revision       Int
  snapshot       Json
  authorUserId   String
