# Local development only. Copy to .env and fill Discord values outside chat.
# The database password below matches docker-compose.yml for a disposable local database.
# Do not reuse it on a shared or production host.

NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://collective:collective@localhost:5433/collective
DEFAULT_TIMEZONE=Australia/Perth
BOT_HEALTH_HOST=0.0.0.0
BOT_HEALTH_PORT=8081
WORKER_HEALTH_PORT=8082
ADMIN_PORT=5173
ADMIN_ORIGIN=http://localhost:5173

# Leave blank until a separate test application exists. Never commit real values.
# Provider keys are optional. Empty values stay setup-required and do not block verification or roles.
STEAM_WEB_API_KEY=
RIOT_API_KEY=
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
EA_CLIENT_ID=
EA_CLIENT_SECRET=
UBISOFT_CLIENT_ID=
UBISOFT_CLIENT_SECRET=
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=
PSN_CLIENT_ID=
PSN_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
BUNGIE_CLIENT_ID=
BUNGIE_CLIENT_SECRET=

DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_TEST_GUILD_ID=
DISCORD_PRODUCTION_GUILD_ID=
DISCORD_CLIENT_SECRET=

# Passphrase for scripts/secret-backup.mjs. Leave blank until a backup is needed.
# It is not a Discord secret and it is not stored in PostgreSQL. An empty value stays setup_required.
BACKUP_PASSPHRASE=

# Browser-visible health URL. Inside Docker Desktop this stays on the host port.
VITE_BOT_HEALTH_URL=http://localhost:8081/health
